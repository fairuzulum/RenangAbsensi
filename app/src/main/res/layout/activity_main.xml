<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo, Coach!"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Family Surya School Club"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/ivProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="2dp"
                android:src="@drawable/logo_renang"
                app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvGreeting"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/primary_blue"
                app:strokeWidth="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImageContainer"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginHorizontal="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_fss_team"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/fssteam" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMenuHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Menu Utama"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardImageContainer" />

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/menuFlow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:constraint_referenced_ids="cardAbsensi,cardPembayaran,cardRegister,cardListSiswa,cardFinancial,cardAttendanceReport,cardSettings"
                app:flow_horizontalGap="8dp"
                app:flow_maxElementsWrap="2"
                app:flow_verticalGap="8dp"
                app:flow_wrapMode="aligned"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMenuHeader" />

            <!-- Menu Cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAbsensi"
                style="@style/MainMenuCard"
                app:cardBackgroundColor="@color/primary_blue"
                app:strokeWidth="0dp">
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_attendance" app:tint="@color/white"/>
                    <TextView style="@style/MainMenuText" android:text="Absensi" android:textColor="@color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPembayaran"
                style="@style/MainMenuCard"
                >
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_payment" />
                    <TextView style="@style/MainMenuText" android:text="Pembayaran" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegister"
                style="@style/MainMenuCard"
                >
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_register" />
                    <TextView style="@style/MainMenuText" android:text="Register" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardListSiswa"
                style="@style/MainMenuCard"
                >
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_student_list" />
                    <TextView style="@style/MainMenuText" android:text="List Siswa" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFinancial"
                style="@style/MainMenuCard"
                >
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_finance" />
                    <TextView style="@style/MainMenuText" android:text="Keuangan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttendanceReport"
                style="@style/MainMenuCard"
                >
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_attendance_report" />
                    <TextView style="@style/MainMenuText" android:text="Laporan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                style="@style/MainMenuCard">
                <LinearLayout style="@style/MainMenuContent">
                    <ImageView style="@style/MainMenuIcon" android:src="@drawable/ic_settings" />
                    <TextView style="@style/MainMenuText" android:text="Pengaturan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
