<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AbsenRenang" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Global override for potential pink tints -->
        <item name="colorSecondary">@color/primary_blue</item>
        <item name="colorTertiary">@color/primary_blue</item>
        <item name="materialAlertDialogTheme">@style/Theme.App.AlertDialog</item>
    </style>

    <style name="Theme.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="Theme.AbsenRenang" parent="Base.Theme.AbsenRenang" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/soft_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_renang</item>
        <item name="postSplashScreenTheme">@style/Theme.AbsenRenang</item>
    </style>

    <!-- Custom Theme for DatePicker to fix pink color -->
    <style name="Theme.App.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Overwrite pink defaults in M3 -->
        <item name="colorSecondary">@color/primary_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/primary_blue</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorSecondaryContainer">@color/soft_blue</item>
        <item name="colorOnSecondaryContainer">@color/primary_blue</item>
        <item name="colorTertiaryContainer">@color/soft_blue</item>
        <item name="colorOnTertiaryContainer">@color/primary_blue</item>

        <item name="colorOutline">@color/divider</item>
    </style>

    <style name="ThemeOverlay.Material3.MaterialAlertDialog.Centered" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:gravity">center</item>
    </style>

    <style name="MainMenuCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <style name="MainMenuContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="MainMenuIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="tint">@color/primary_blue</item>
    </style>

    <style name="MainMenuText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">15sp</item> <item name="android:textStyle">bold</item> <item name="android:textAlignment">center</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Left" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>