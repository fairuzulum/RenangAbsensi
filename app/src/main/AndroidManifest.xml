<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AbsenRenang">
        <activity
            android:name=".ui.report.AttendanceReportActivity"
            android:exported="false" />
        <activity android:name=".ui.studentlist.StudentDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.studentlist.EditStudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.attendance.AttendanceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.attendance.AttendanceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.studentlist.StudentListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.financial.FinancialReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.NotificationManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.ClassificationManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AbsenRenang">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsenRenang" />
        <activity
            android:name=".ui.auth.PinEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsenRenang" />
        <activity
            android:name=".ui.auth.SetPinActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsenRenang" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>